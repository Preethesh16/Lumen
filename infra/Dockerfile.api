FROM node:22-alpine

RUN npm install --global pnpm@10.34.5
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json eslint.config.js ./
COPY apps/api/package.json apps/api/package.json
COPY packages/scoring/package.json packages/scoring/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
RUN pnpm install --frozen-lockfile

COPY apps/api apps/api
COPY packages packages
RUN pnpm --filter "./packages/**" build && pnpm --filter @lumen/api build

ENV NODE_ENV=production
EXPOSE 4000
CMD ["sh", "-c", "pnpm --filter @lumen/api db:migrate && pnpm --filter @lumen/api db:seed && pnpm --filter @lumen/api start"]
