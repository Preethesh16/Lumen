# Copy to .env and fill in. NEVER commit .env.

# ---- Postgres ----
POSTGRES_USER=lumen
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=lumen
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lumen:change_me_locally@localhost:5432/lumen

# ---- API ----
API_PORT=4000
NODE_ENV=development
# Shared secret n8n must send as `x-lumen-webhook-secret` on POST /webhook/n8n-score-update
N8N_WEBHOOK_SECRET=change_me_locally

# ---- n8n ----
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_locally
# 32+ char key n8n uses to encrypt stored credentials. Generate: openssl rand -hex 16
N8N_ENCRYPTION_KEY=change_me_locally_32_chars_min__
# Base URL n8n uses to reach the API. On Docker Desktop use http://host.docker.internal:4000
LUMEN_API_BASE_URL=http://host.docker.internal:4000

# ---- Upstream data sources (all free; no API keys required) ----
# ReliefWeb requires an identifying appname param, not a key.
RELIEFWEB_APPNAME=lumen-crisis-monitor

# ---- Deepthi's side (documented here so .env stays one file) ----

# Dashboard → API. When unset, apps/web serves clearly-labelled placeholder
# data instead of failing, so the frontend runs without the backend up.
LUMEN_API_URL=http://localhost:4000
# Public dashboard URL, used in digest email links.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Content-generation agent.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# Telegram delivery. Token from @BotFather; the bot must be a channel admin.
TELEGRAM_BOT_TOKEN=
# Channel or chat id, e.g. -1001234567890 for a channel.
TELEGRAM_CHAT_ID=

# Resend weekly digest. DIGEST_FROM_EMAIL must be on a Resend-verified domain.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=lumen@example.com
