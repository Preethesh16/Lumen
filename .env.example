# Copy to .env and fill in. NEVER commit .env.

# ---- Postgres ----
POSTGRES_USER=lumen
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=lumen
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lumen:change_me_locally@localhost:5432/lumen

# ---- API ----
API_PORT=4000
NODE_ENV=development
# Shared secret n8n must send as `x-lumen-webhook-secret` on POST /webhook/n8n-score-update
N8N_WEBHOOK_SECRET=change_me_locally

# ---- n8n ----
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_locally
# 32+ char key n8n uses to encrypt stored credentials. Generate: openssl rand -hex 16
N8N_ENCRYPTION_KEY=change_me_locally_32_chars_min__
# Base URL n8n uses to reach the API. On Docker Desktop use http://host.docker.internal:4000
LUMEN_API_BASE_URL=http://host.docker.internal:4000

# ---- Upstream data sources (all free; no API keys required) ----
# ReliefWeb requires an identifying appname param, not a key.
RELIEFWEB_APPNAME=lumen-crisis-monitor

# ---- Brief generation ----
# Optional. Without it Lumen generates a deterministic, fully grounded brief.
# Create a key at https://console.groq.com/keys. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Delivery ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Lumen <briefs@example.com>"
DELIVERY_EMAIL_TO=
# Public dashboard URL used in Telegram/email digest links.
DASHBOARD_BASE_URL=http://localhost:3000

# ---- Web dashboard (server-side only; never prefix these with NEXT_PUBLIC_) ----
API_BASE_URL=http://localhost:4000
# Optional override. When empty, the server uses N8N_WEBHOOK_SECRET.
LUMEN_ADMIN_SECRET=
