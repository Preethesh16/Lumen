# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---------------------------------------------------------------------------
# Lumen API (Preethesh's apps/api)
# ---------------------------------------------------------------------------
# When unset, apps/web serves clearly-labelled placeholder data instead of
# failing, so the dashboard is reviewable before the API exists.
LUMEN_API_URL=http://localhost:4000

# Public URL of the dashboard, used in digest email links.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Content-generation agent
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Delivery
# ---------------------------------------------------------------------------
# From @BotFather. The bot must be an admin of the target channel.
TELEGRAM_BOT_TOKEN=
# Channel or chat id, e.g. -1001234567890 for a channel.
TELEGRAM_CHAT_ID=

# Resend — weekly digest email.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
DIGEST_FROM_EMAIL=lumen@example.com

# ---------------------------------------------------------------------------
# Database (Preethesh's side — listed here so one file documents everything)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://lumen:lumen@localhost:5432/lumen
