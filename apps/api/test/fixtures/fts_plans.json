e, "latestVersion": true, "latestTaggedVersion": true, "versionTags": ["0.1", "0.2", "1.0"], "createdAt": "2024-09-30T09:37:41.218Z", "updatedAt": "2025-05-07T09:47:28.686Z"}}], "origRequirements": 622010264, "revisedRequirements": 622010264}, {"id": 1212, "revisionState": "none", "isReleased": true, "releasedDate": "2025-03-24T10:49:01.420Z", "createdAt": "2024-09-30T09:44:06.387Z", "updatedAt": "2026-06-18T16:47:31.531Z", "planVersion": {"id": 8566, "planId": 1212, "name": "Rohingya Humanitarian Crisis Joint Response Plan 2025", "shortName": "Rohingya (JRP)", "subtitle": "Joint Response Plan", "startDate": "2025-01-01", "endDate": "2025-12-31", "comments": null, "isForHPCProjects": true, "isPartOfGHO": true, "code": "RBGD25", "customLocationCode": null, "currentReportingPeriodId": 3174, "lastPublishedReportingPeriodId": 3174, "clusterSelectionType": "single", "visibilityPreferences": {"isForNewHPCProjects": true, "isDisaggregationForCaseloads": true, "isDisaggregationForIndicators": true}, "pdfPublishDate": "2025-03-24", "focusLocationId": 19, "currentVersion": true, "latestVersion": true, "latestTaggedVersion": true, "versionTags": ["2.4"], "createdAt": "2026-06-15T07:20:15.347Z", "updatedAt": "2026-06-18T16:47:47.886Z", "organizations": [{"id": 4397, "name": "United Nations High Commissioner for Refugees", "nativeName": "Haut Commissariat des Nations Unies pour les r\u00e9fugi\u00e9s (HCR)", "abbreviation": "UNHCR", "url": "https://www.unhcr.org/", "parentID": null, "comments": null, "verified": true, "notes": null, "active": true, "collectiveInd": false, "newOrganizationId": null, "createdAt": "2017-01-14T00:54:02.286Z", "updatedAt": "2022-02-04T09:14:54.640Z", "deletedAt": null, "planVersionOrganization": {"planVersionId": 8566, "organizationI": 4397, "createdAt": "2026-06-15T07:20:15.347Z", "updatedAt": "2026-06-15T07:20:15.347Z"}}, {"id": 2986, "name": "International Organization for Migration", "nativeName": "Organisation internationale pour les migrations (OIM), Organizaci\u00f3n Internacional para las Migraciones (OIM)", "abbreviation": "IOM", "url": "https://www.iom.int/", "parentID": null, "comments": "About IOM\n\nEstablished in 1951, IOM is the leading inter-governmental organization in the field of migration and works closely with governmental, intergovernmental and non-governmental partners.\n\nWith 173 member states, a further 9 states holding observer status and offices in over 100 countries, IOM is dedicated to promoting humane and orderly migration for the benefit of all. It does so by providing services and advice to governments and migrants.\n\nIOM works to help ensure the orderly and humane management of migration, to promote international cooperation on migration issues, to assist in the search for practical solutions to migration problems and to provide humanitarian assistance to migrants in need, including refugees and internally displaced people.\n\nThe IOM Constitution recognizes the link between migration and economic, social and cultural development, as well as to the right of freedom of movement.\n\nIOM works in the four broad areas of migration management:\n\n- Migration and development\n- Facilitating migration\n- Regulating migration\n- Forced migration.\n\nIOM activities that cut across these areas include the promotion of international migration law, policy debate and guidance, protection of migrants' rights, migration health and the gender dimension of migration.", "verified": true, "notes": "Added Native Language, Website and Description", "active": true, "collectiveInd": false, "newOrganizationId": null, "createdAt": "2017-01-14T00:53:57.579Z", "updatedAt": "2021-03-30T15:31:06.166Z", "deletedAt": null, "planVersionOrganization": {"planVersionId": 8566, "organizationI": 2986, "createdAt": "2026-06-15T07:20:15.347Z", "updatedAt": "2026-06-15T07:20:15.347Z"}}]}, "categories": [{"id": 111, "name": "Regional response plan", "description": null, "parentID": null, "code": "REG", "group": "planType", "createdAt": "2017-01-13T22:18:02.041Z", "updatedAt": "2025-03-20T17:11:26.689Z", "categoryRef": {"objectID": 1212, "versionID": 1, "objectType": "plan", "categoryID": 111, "createdAt": "2024-09-30T09:44:06.438Z", "updatedAt": "2024-09-30T09:44:06.438Z"}}, {"id": 1874, "name": "en", "description": null, "parentID": null, "code": null, "group": "planLanguage", "createdAt": "2024-09-16T14:31:24.063Z", "updatedAt": "2024-09-16T14:31:24.063Z", "categoryRef": {"objectID": 1212, "versionID": 1, "objectType": "plan", "categoryID": 1874, "createdAt": "2024-09-30T09:44:06.438Z", "updatedAt": "2024-09-30T09:44:06.438Z"}}, {"id": 1878, "name": "sector", "description": null, "parentID": null, "code": null, "group": "planClusterType", "createdAt": "2024-09-16T14:31:24.224Z", "updatedAt": "2024-09-16T14:31:24.224Z", "categoryRef": {"objectID": 1212, "versionID": 1, "objectType": "plan", "categoryID": 1878, "createdAt": "2024-09-30T09:44:06.438Z", "updatedAt": "2024-09-30T09:44:06.438Z"}}], "emergencies": [], "locations": [{"id": 19, "externalId": "199", "name": "Bangladesh", "adminLevel": 0, "latitude": 23.882074266172, "longitude": 90.241072643933, "iso3": "BGD", "pcode": "BD", "validOn": null, "status": "active", "itosSync": true, "isRegion": false, "createdAt": "2015-09-10T20:25:09.412Z", "updatedAt": "2023-04-29T00:05:06.989Z", "parentId": null, "planLocation": {"id": 1655, "planId": 1212, "locationId": 19, "currentVersion": true, "latestVersion": true, "latestTaggedVersion": true, "versionTags": ["0.1", "0.2", "1.0", "2.0", "2.1", "2.2", "2.3", "2.4"], "createdAt": "2024-09-30T09:44:42.323Z", "updatedAt": "2026-06-18T16:47:31.622Z", "deletedAt": null}}], "years": [{"id": 46, "year": "2025", "createdAt": "2016-02-23T15:03:30.955Z", "updatedAt": "2016-02-23T15:03:30.955Z", "planYear": {"id": 989, "planId": 1212, "usageYearId": 46, "currentVersion": true, "latestVersion": true, "latestTaggedVersion": true, "versionTags": ["0.1", "0.2", "1.0", "2.0", "2.1", "2.2", "2.3", 